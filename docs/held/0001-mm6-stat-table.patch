+import { describe, expect, it } from 'vitest';
+import { statBonus } from './stats';
+
+/** MM6's statistic effects (MM6-GAPS.md 3, GF-M): a score at or above the first earns the second. */
+const MM6_TABLE: readonly [number, number][] = [
+  [0, -6],
+  [3, -5],
+  [5, -4],
+  [7, -3],
+  [9, -2],
+  [11, -1],
+  [13, 0],
+  [15, 1],
+  [17, 2],
+  [19, 3],
+  [21, 4],
+  [25, 5],
+  [30, 6],
+  [35, 7],
+  [40, 8],
+  [50, 9],
+  [75, 10],
+  [100, 11],
+  [125, 12],
+  [150, 13],
+  [175, 14],
+  [200, 15],
+  [225, 16],
+  [250, 17],
+  [275, 18],
+  [300, 19],
+  [350, 20],
+  [400, 25],
+  [500, 30],
+];
+
+describe('stat effects', () => {
+  it('follows MM6’s table at every threshold and just below it', () => {
+    MM6_TABLE.forEach(([score, effect], i) => {
+      expect(statBonus(score)).toBe(effect);
+      if (i > 0) expect(statBonus(score - 1)).toBe(MM6_TABLE[i - 1]![1]);
+    });
+    expect(statBonus(4)).toBe(-5);
+    expect(statBonus(12)).toBe(-1);
+    expect(statBonus(14)).toBe(0);
+    expect(statBonus(999)).toBe(30);
+  });
+
+  it('matches screenshot-21: Accuracy 15 gives +1, Might 17 +2, Speed 13 nothing', () => {
+    // Attack +2 is Accuracy 15 plus Sword 1; Damage 5–11 is a 3–9 sword plus Might 17.
+    expect(statBonus(15) + 1).toBe(2);
+    expect(3 + statBonus(17)).toBe(5);
+    expect(9 + statBonus(17)).toBe(11);
+    expect(statBonus(13)).toBe(0);
+  });
+});
