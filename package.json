{
  "name": "fable-token-burner",
  "private": true,
  "version": "0.0.1",
  "description": "A Might and Magic VI inspired first-person party RPG for phones, built on Fable.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "secrets:guard": "tsx tools/secrets-guard.ts",
    "icons": "tsx tools/icons.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run secrets:guard"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.30.0",
    "@babylonjs/materials": "^9.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
